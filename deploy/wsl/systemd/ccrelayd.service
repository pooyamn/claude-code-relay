[Unit]
Description=ccrelayd: Telegram to per-folder Claude Code / codex relay
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 -u %h/.openclaw/workspace/scripts/ccrelayd.py --config %h/.config/ccrelay/prod.json
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
