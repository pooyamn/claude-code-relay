# INERT TEMPLATE. Trusted launcher must render and validate these placeholders.
# Unit name: ccrelay-session-@EXECUTION_ID@.service (not user-created services).
[Unit]
Description=ccrelay @ROLE@ execution @EXECUTION_ID@
After=ccrelay-broker.service
Requires=ccrelay-broker.service

[Service]
Type=exec
User=ccrelay-@ROLE@
Group=ccrelay-@ROLE@
SupplementaryGroups=ccrelay-clients
WorkingDirectory=/var/lib/ccrelay/roles/@ROLE@/worktrees/@SESSION_ID@
Environment=HOME=/var/lib/ccrelay/roles/@ROLE@
Environment=XDG_RUNTIME_DIR=/var/lib/ccrelay/roles/@ROLE@/runtime
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/ccrelay/roles/@ROLE@
Delegate=no
KillMode=control-group
# ExecStart and measured CPU/RAM/process limits belong to the PR 7 launcher.
# No activation, shared login home, writer transfer or runtime fallback here.
