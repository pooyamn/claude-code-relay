#!/usr/bin/env bash
# Per-folder persistent, resumable Claude relay: one dedicated Claude session per
# project folder. Reopens (resumes) the SAME conversation even after the tmux
# session or the whole machine dies, via Claude Code's per-folder `--continue`.
#
# Usage: claude-relay-group <WORKDIR> "<prompt>"
#   WORKDIR  - the project folder this group/session is bound to
#
# The folder IS the durable key: same folder -> same Claude conversation, forever.
set -uo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"   # release-local helpers
RAW="${1:?usage: claude-relay-group <WORKDIR> \"<prompt>\"}"; shift
WORKDIR="$(cd "$RAW" 2>/dev/null && pwd)" || { echo "claude-relay-group: no such folder: $RAW" >&2; exit 1; }
# md5 hex of stdin: `md5` on macOS, `md5sum` on Linux (same hex, different framing).
_md5() { if command -v md5 >/dev/null 2>&1; then md5; else md5sum | cut -d' ' -f1; fi; }
KEY="cr-$(printf '%s' "$WORKDIR" | _md5 | cut -c1-10)"   # stable per-folder tmux name
DIR0="$DIR"
RW0="$DIR0/relay-work"

# "Alive" = the claude TUI is running in ANY usable state: idle input box, busy
# turn, OR an open selection menu. Crucially we must NOT treat an open menu as
# dead, or the session (and the menu) gets killed right before a button pick.
# NOTE: an ALT backend (`cc model ik3` -> kimi) renders NONE of claude's chrome. Its
# input bar carries a "context: N% (a/b)" gauge instead. Without that alternation a
# healthy kimi session reads as dead here and gets killed + replaced by claude on the
# very next message -- which is exactly what silently broke ik3 (the session came back
# as claude while the backend marker still said kimi, so the watcher scraped a claude
# pane with the kimi parser and delivered nothing).
# Liveness. Getting this wrong is ASYMMETRIC: a false "dead" KILLS a working
# session mid-turn (the user sees "Session churned right before launch"), while a
# false "alive" merely skips a relaunch. So test the thing that actually decides
# it -- is a TUI process running in the pane -- and keep pane-scraping only as a
# fallback for the case that matters (the TUI exited and left a bare shell).
# Screen text alone was too fragile: it has to match every backend's chrome in
# every state, and one unrecognised frame (a modal, a redraw, a background-agent
# view) was enough to destroy a live session.
ready(){
  # Primary test: is a TUI in the FOREGROUND of the pane? Ask tmux, and decide by
  # what it is NOT. Matching binary names does not work -- claude's is version-named
  # ("2.1.237"), opencode's is "opencode.exe" -- so any allowlist rots on the next
  # release. A shell in the foreground means the TUI exited; anything else means it
  # is running, whatever it renders on screen.
  local fg strikes f
  fg="$(tmux display-message -p -t "$KEY" '#{pane_current_command}' 2>/dev/null)"
  case "$fg" in
    ""|zsh|bash|sh|dash|fish|login|tmux) return 1 ;;   # shell in front: TUI exited
  esac
  # NOTE: "• OpenCode <version>" is deliberately NOT in that list. It is a static
  # footer that survives a crash -- it was still on screen under a bun stack trace
  # with the input box gone, so treating it as chrome made a dead TUI look healthy
  # forever. The input bar ("ctrl+p commands") is the signal that actually tracks
  # whether the UI is functioning.
  # Claude Code LATCHES logged-out. Credentials are read ONCE at launch, so when the
  # OAuth token is refreshed under a live process (anthropic-auth-sync rotates it a
  # few times a day) the old one 401s, the TUI flips to "Please run /login", and from
  # then on it answers EVERY turn with that -- instantly, without calling the API.
  # Chrome is intact and the process is alive, so every other test here reports a
  # healthy session while the topic is dead (hardware topic 18, 2026-08-24: three
  # hours of "Login expired" while a fresh `claude -p` on the same credentials worked).
  # A relaunch re-reads the refreshed credentials, so treat the latch as not-ready.
  # Scoped to the tail of the pane: a session that has since recovered scrolls the
  # message away, only a still-latched one keeps it as the most recent output.
  if tmux capture-pane -t "$KEY" -p 2>/dev/null | tail -20 \
       | grep -qE "(Login expired|Not logged in).*Please run /login"; then
    rm -f "$RW0/nochrome-$KEY"
    return 1
  fi
  f="$RW0/nochrome-$KEY"
  if tmux capture-pane -t "$KEY" -p 2>/dev/null | grep -qE "for agents|for shortcuts|esc to interrupt|esc interrupt|Esc to cancel|to navigate|❯ +[0-9]+\.|context: *[0-9.]+% *\(|ctrl\+p commands|[0-9.]+K \([0-9]+%\)"; then
    rm -f "$f"; return 0
  fi
  # Process alive but NO chrome. Both states look like this and must be told apart:
  # a transient frame (modal, redraw, agent view) -- killing on that is what churned
  # live sessions -- and a CRASHED TUI, which opencode does: an EventEmitter
  # listener overflow left a bun stack trace on screen, input box gone, process
  # still running. Process-liveness alone would keep that forever, delivering
  # nothing. So require the absence to PERSIST before declaring it dead.
  strikes=$(( $(cat "$f" 2>/dev/null || echo 0) + 1 ))
  printf '%s' "$strikes" > "$f" 2>/dev/null || true
  [ "$strikes" -lt 3 ] && return 0
  rm -f "$f"; return 1
}

# --- codex: a backend with NO terminal ------------------------------------
# Every other backend here is a TUI in a tmux pane, so the whole block below
# (liveness probe, kill+relaunch, chrome wait) exists to keep a terminal alive.
# codex has a real non-interactive mode: a turn is a detached `codex exec`
# process and the conversation lives in its thread_id, so there is nothing to
# keep alive between turns. Creating a pane anyway would be actively harmful --
# ready() would find a bare shell in it, call the session dead, and kill+relaunch
# on EVERY message.
CX_PIN="$(cat "$RW0/default-model-$KEY.txt" 2>/dev/null | tr -d '[:space:]')"
if [ "$CX_PIN" = "cx" ] || [ "$(python3 -c "
import json,sys
try: print(json.load(open('$RW0/backend-$KEY.json')).get('backend',''))
except Exception: print('')" 2>/dev/null)" = "codex" ]; then
  CXCFG="$DIR0/relay-claude-settings-cx.json"
  python3 - "$CXCFG" "$RW0/backend-$KEY.json" <<'PY' 2>/dev/null || true
import json, sys
try:
    cfg = json.load(open(sys.argv[1]))
except Exception:
    cfg = {}
json.dump({"backend": "codex", "model": cfg.get("model", "")}, open(sys.argv[2], "w"))
PY
  export CLAUDE_RELAY_SESSION="$KEY"
  WKEY="crw-${KEY#cr-}"
  if ! tmux has-session -t "$WKEY" 2>/dev/null; then
    tmux new-session -d -s "$WKEY" -c "$DIR0" \
      "CLAUDE_RELAY_SESSION='$KEY' RELAY_STREAM='${RELAY_STREAM:-1}' exec python3 '$DIR0/claude-relay-send.py' --watch"
  fi
  exec python3 "$DIR0/claude-relay-send.py" "$@"
fi

if ! ( tmux has-session -t "$KEY" 2>/dev/null && ready ); then
  tmux kill-session -t "$KEY" 2>/dev/null || true
  # resume the folder's existing conversation if one exists, else start fresh
  RW="$RW0"
  ENC="$(printf '%s' "$WORKDIR" | sed 's#[/.]#-#g')"
  CONT=""
  # Resume a PINNED conversation id when one is recorded, not "whatever ran last".
  # --continue follows ~/.claude.json's lastSessionId, which is global state anything
  # can move: a stray `claude` in the folder, a fork, an interrupted launch. When it
  # moved for ai-hil, --continue started answering from a 35-message "Hi" session
  # while 6527 messages of real history sat untouched on disk -- the session looked
  # wiped although nothing was deleted. The pin makes the conversation a property of
  # the BINDING instead of a global pointer.
  SIDF="$RW/claude-session-$KEY.txt"
  SID="$(cat "$SIDF" 2>/dev/null | tr -d '[:space:]')"
  if [ -n "$SID" ] && [ -f "$HOME/.claude/projects/$ENC/$SID.jsonl" ]; then
    CONT="--resume $SID"
  elif ls "$HOME/.claude/projects/$ENC"/*.jsonl >/dev/null 2>&1; then
    CONT="--continue"
  fi
  # Pre-accept folder trust instead of answering the dialog. Claude Code's trust
  # prompt now DEFAULTS TO "No, exit", and the loop below used to answer it with a
  # bare Enter -- which exits the TUI and leaves a shell in the pane. That silently
  # killed every topic whose folder had no trust entry (7 of 14 bound folders on
  # 2026-09-24, including the web, base-board and DUT topics). Seeding
  # hasTrustDialogAccepted before launch means the dialog never appears, so its
  # default can never matter again. Atomic replace: ~/.claude.json is live state.
  python3 - "$WORKDIR" <<'TRUST' 2>/dev/null || true
import json, os, sys
p = os.path.expanduser("~/.claude.json")
try:
    d = json.load(open(p))
except Exception:
    sys.exit(0)
e = d.setdefault("projects", {}).setdefault(sys.argv[1], {})
if not e.get("hasTrustDialogAccepted"):
    e["hasTrustDialogAccepted"] = True
    tmp = p + ".relay-tmp"
    open(tmp, "w").write(json.dumps(d, indent=2))
    os.replace(tmp, p)
TRUST
  tmux new-session -d -s "$KEY" -x 200 -y 50
  # Per-folder session, but global memory + global skills stay loaded (Pouya wants
  # them available in bound sessions). --settings pins auto-memory to the global
  # memory dir so it loads regardless of the folder's own git root; skills load by
  # default. Isolation is just the separate folder/session.
  SETTINGS="$DIR/relay-claude-settings.json"
  # This path ALWAYS (re)launches claude, so the session's backend marker must be
  # reset to claude. Leaving a stale `kimi` marker here makes the watcher parse a
  # claude pane with the kimi parser -> extracts nothing -> replies never delivered.
  # A folder can PIN a native ALT backend by naming a model token in
  # default-model-<KEY>.txt (e.g. "ox"). Without this the relaunch path below
  # unconditionally rewrote the marker to claude, so `cc model ox` survived only
  # until the next respawn: the pin appeared to work, then silently reverted.
  # relay-alt-launch resolves the token through the SAME relay-claude-settings-
  # <token>.json the `cc model` path uses, so a token means one thing either way.
  ALT="$(python3 "$DIR/relay-alt-launch" \
        "$(cat "$RW/default-model-$KEY.txt" 2>/dev/null)" "$WORKDIR" 2>/dev/null || true)"
  if [ -n "$ALT" ]; then
    printf '%s' "${ALT%%$'\t'*}" > "$RW/backend-$KEY.json" 2>/dev/null || true
    tmux send-keys -t "$KEY" "cd $WORKDIR && ${ALT#*$'\t'}" Enter
  else
    # This path relaunches CLAUDE, so the marker must be reset. Leaving a stale
    # alt marker makes the watcher parse a claude pane with the wrong parser ->
    # extracts nothing -> replies never delivered (exactly how ik3 broke).
    printf '{"backend": "claude"}' > "$RW/backend-$KEY.json" 2>/dev/null || true
    tmux send-keys -t "$KEY" "cd $WORKDIR && claude $CONT --settings $SETTINGS --dangerously-skip-permissions" Enter
  fi
  for i in $(seq 1 90); do
    sleep 1
    pane="$(tmux capture-pane -t "$KEY" -p 2>/dev/null || true)"
    # Belt and braces if the dialog still appears (e.g. trust was rejected by a
    # concurrent ~/.claude.json writer). NEVER a bare Enter: the default is
    # "No, exit". "2" selects "Yes, I trust this folder" directly.
    if printf '%s' "$pane" | grep -q "trust this folder"; then
      tmux send-keys -t "$KEY" 2; sleep 0.5
      tmux send-keys -t "$KEY" Enter; sleep 2
    fi
    # Big-session resume dialog ("Resume from summary / Resume full session as-is").
    # Claude Code raises it on --resume once a conversation gets large, and nothing
    # here answered it: the loop spun its full 90s on the menu, then the prompt was
    # typed INTO the menu, so the topic went silent while the pane looked healthy --
    # ready() deliberately treats an open menu as alive (topic 816, 2026-09-01).
    # Pick option 2, FULL session: the SID pin exists precisely to keep this
    # conversation whole, and answering with the default would quietly trade it for
    # a summary on every respawn. Costs tokens; that is the intended trade.
    if printf '%s' "$pane" | grep -q "Resume from summary"; then
      tmux send-keys -t "$KEY" Down; sleep 0.5
      tmux send-keys -t "$KEY" Enter; sleep 3
      continue
    fi
    if printf '%s' "$pane" | grep -qE "for agents|for shortcuts"; then break; fi
  done

  # opencode only: a session RESUMED into an unfinished subagent turn accepts no
  # keystrokes -- ever. opencode blocks TUI input while a subagent runs, and if the
  # TUI dies mid-run (crash, restart) that state is stored in the session, so every
  # `-s <id>` resume re-enters the block while the subagent process is long gone.
  # It looks exactly like a hung session: process alive, chrome drawn, input ignored,
  # nothing delivered. There is no flag in opencode's db to read (session_input is
  # empty), so test the behaviour: type a token and see whether it echoes. If not,
  # relaunch WITHOUT the resume flag -- a fresh session is worth more than a wedged
  # one that can never answer again.
  if printf '%s' "${ALT:-}" | grep -q '"opencode"'; then
    PROBE="zzprobe$$"
    tmux send-keys -t "$KEY" "$PROBE"; sleep 2
    if tmux capture-pane -t "$KEY" -p 2>/dev/null | grep -q "$PROBE"; then
      for _ in $(seq 1 ${#PROBE}); do tmux send-keys -t "$KEY" BSpace; done
    else
      echo "relay: opencode session wedged on resume; starting fresh" >&2
      tmux kill-session -t "$KEY" 2>/dev/null || true
      tmux new-session -d -s "$KEY" -x 200 -y 50
      # STRIP the resume flag. Reusing the same command relaunched straight back
      # into the wedged session -- "fresh" that resumes the broken session is not
      # fresh at all, and the probe would just fire again next time.
      FRESHCMD="$(printf '%s' "${ALT#*$'\t'}" | sed 's/ -s ses_[A-Za-z0-9]*//')"
      tmux send-keys -t "$KEY" "cd $WORKDIR && $FRESHCMD" Enter
      for i in $(seq 1 90); do
        sleep 1
        printf '%s' "$(tmux capture-pane -t "$KEY" -p 2>/dev/null || true)" \
          | grep -qE "ctrl\+p commands|[0-9.]+K \([0-9]+%\)" && break
      done
    fi
  fi
fi

export CLAUDE_RELAY_SESSION="$KEY"

# Persistent-watcher model (opt-in via env or a relay-work/WATCH sentinel): keep
# ONE long-lived watcher per session in its own tmux session, so every turn --
# including long ones that finish after the inbound message is long gone -- gets
# delivered. The per-message call below then only injects.
if [ "${RELAY_WATCH:-0}" = "1" ] || [ -f "$DIR/relay-work/WATCH" ]; then
  WKEY="crw-${KEY#cr-}"
  if ! tmux has-session -t "$WKEY" 2>/dev/null; then
    # -c "$DIR": pin the watcher's cwd to the scripts dir so its child WS
    # edit-server (node relay-ws-edit-server.mjs) resolves the global openclaw
    # module. Launched from another cwd, node fails ERR_MODULE_NOT_FOUND and the
    # live progress bubble silently never draws.
    tmux new-session -d -s "$WKEY" -c "$DIR" \
      "CLAUDE_RELAY_SESSION='$KEY' RELAY_STREAM='${RELAY_STREAM:-1}' exec python3 '$DIR/claude-relay-send.py' --watch"
  fi
fi

exec python3 "$DIR/claude-relay-send.py" "$@"
