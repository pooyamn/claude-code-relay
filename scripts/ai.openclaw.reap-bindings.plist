<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.openclaw.reap-bindings</string>
	<key>Comment</key>
	<string>Sweep dead Telegram relay bindings (missing workspace / migrated chat id / orphan config). Config-only; never restarts the gateway.</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>/Users/pouya/.openclaw/workspace/scripts/reap-dead-bindings.py</string>
		<string>--apply</string>
		<string>--quiet</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/opt/homebrew/opt/node@24/bin:/usr/bin:/bin</string>
	</dict>
	<key>StartInterval</key>
	<integer>21600</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/pouya/.openclaw/logs/reap-bindings.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/pouya/.openclaw/logs/reap-bindings.log</string>
</dict>
</plist>
