#!/usr/bin/env python3
"""Resolve a `cc model` token + folder to a NATIVE ALT CLI launch command.

Prints "<backend-json>\t<command>" when the token names a native backend, and
nothing at all otherwise (so the caller falls through to claude). Reads the same
relay-claude-settings-<token>.json the `cc model` path uses, so a token means one
thing whether it arrives from chat or from a folder's pinned default.

Continuation is DIRECTORY-SCOPED, which is the whole reason this is not a plain
string template. `opencode -c` continues the most recently used session GLOBALLY,
not the one for this folder: pinning a folder to ox and relaunching resumed an
unrelated project's conversation, in that project's directory (observed live --
the kicad session came up inside a scratch dir). opencode records each session's
directory in its own SQLite db, so resolve the newest session FOR THIS FOLDER and
pass -s <id>; with no match, start clean rather than inherit someone else's.
kimi's -c is per-directory already, so it keeps using it.
"""
import hashlib, json, os, shlex, shutil, socket, sqlite3, sys

D = "/Users/pouya/.openclaw/workspace/scripts"
OC_DB = os.path.expanduser("~/.local/share/opencode/opencode.db")

def opencode_resume_flag(folder):
    if not folder or not os.path.exists(OC_DB):
        return ""
    real = os.path.realpath(folder)
    try:
        con = sqlite3.connect(f"file:{OC_DB}?mode=ro", uri=True)
        rows = con.execute(
            "SELECT id, directory FROM session ORDER BY rowid DESC LIMIT 400").fetchall()
    except Exception:
        return ""
    for sid, d in rows:
        if d and os.path.realpath(d) == real:
            return f" -s {sid}"
    return ""

OC_PORT_BASE, OC_PORT_SPAN = 4100, 700

def _free(port):
    with socket.socket() as sk:
        try:
            sk.bind(("127.0.0.1", port)); return True
        except OSError:
            return False

def opencode_port(folder):
    """Stable loopback port so this session is remote-controllable.

    opencode's TUI serves its own API when given --port, which is the equivalent of
    Claude Code's remoteControlAtStartup -- without it a session can only be driven
    from its terminal. Derived from the folder so a session keeps the same port
    across restarts (a random port would be unreachable without rediscovery), and
    probed for collisions because two folders can hash to one slot. Bound to
    127.0.0.1: remote access goes through a tunnel, never a raw public listener.
    """
    h = int(hashlib.md5((folder or "default").encode()).hexdigest()[:8], 16)
    start = OC_PORT_BASE + (h % OC_PORT_SPAN)
    for i in range(OC_PORT_SPAN):
        port = OC_PORT_BASE + ((start - OC_PORT_BASE + i) % OC_PORT_SPAN)
        if _free(port):
            return port
    return start

def main():
    if len(sys.argv) < 2 or not sys.argv[1].strip():
        return 0
    tok = sys.argv[1].strip().lower()
    folder = sys.argv[2] if len(sys.argv) > 2 else ""
    try:
        cfg = json.load(open(os.path.join(D, f"relay-claude-settings-{tok}.json")))
    except Exception:
        return 0
    be = cfg.get("backend")
    if be == "kimi":
        name, tmpl, cont = "kimi", "{bin} -m {model} -c --yolo", ""
    elif be == "opencode":
        port = opencode_port(folder)
        try:
            rw = os.path.join(D, "relay-work")
            os.makedirs(rw, exist_ok=True)
            key = "cr-" + hashlib.md5(os.path.abspath(folder).encode()).hexdigest()[:10] if folder else "cr-unknown"
            open(os.path.join(rw, f"opencode-port-{key}.txt"), "w").write(str(port))
        except Exception:
            pass
        name = "opencode"
        tmpl = "{bin} -m {model} --port " + str(port) + " --hostname 127.0.0.1"
        cont = opencode_resume_flag(folder)
    else:
        return 0
    binpath = shutil.which(name) or f"/opt/homebrew/bin/{name}"
    if not os.path.exists(binpath):
        return 0
    cmd = tmpl.format(bin=binpath, model=cfg.get("model", "")) + cont
    # Send the TUI's STDERR to a log instead of the pane. This is the root cause of
    # the "session keeps dying": opencode hit a MaxListenersExceededWarning
    # (EventTarget leak, node:events overflowWarning) and node wrote the warning
    # plus a full object dump to stderr -- which IS the pane. The text overwrote the
    # UI, so the input box and the "▣ Build ·" footer vanished, the scraper found
    # nothing to extract, and the session went silent while its process stayed alive.
    # Proven by control experiment: identical program, stderr to the pane leaves the
    # warning on screen; stderr to a file leaves the pane clean.
    # The leak itself is opencode's bug; keeping its output off the terminal is ours.
    if be == "opencode" and folder:
        key = "cr-" + hashlib.md5(os.path.abspath(folder).encode()).hexdigest()[:10]
        log = os.path.join(D, "relay-work", f"opencode-stderr-{key}.log")
        cmd += f" 2>>{shlex.quote(log)}"
    sys.stdout.write(json.dumps({"backend": be}) + "\t" + cmd)
    return 0

if __name__ == "__main__":
    sys.exit(main())
