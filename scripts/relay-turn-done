#!/usr/bin/env python3
"""Claude Code `Stop` hook for the relay: write a per-session "turn done" marker
holding the EXACT final assistant message, so the watcher delivers the reply on a
deterministic event instead of guessing from idle terminal frames.

Claude runs this when a turn finishes (post-response, pre-input-wait) and pipes a
JSON object on stdin: {session_id, transcript_path, cwd, last_assistant_message,
hook_event_name, ...}. We key the marker by the session's working directory the
same way claude-relay-group derives its tmux session name (cr-<md5(cwd)[:10]>),
so the matching watcher picks it up. Atomic write so the watcher never reads a
half-written file. Never fail the hook (exit 0 regardless)."""
import sys, os, re, json, hashlib, tempfile, subprocess

def _key_for(path):
    return "cr-" + hashlib.md5(os.path.abspath(path).encode()).hexdigest()[:10]

def resolve_key(cwd, base):
    """Work out WHICH relay session this turn belongs to.

    Keying on the hook's `cwd` alone is wrong the moment a session moves into a
    subdirectory (a monorepo subproject, a worktree): the marker lands under
    cr-<md5(subdir)> while the watcher, keyed by the BOUND folder, keeps reading
    cr-<md5(bound)> and never sees it. The turn then falls back to pane scraping --
    and the pane is an alternate screen with NO scrollback, so anything longer than
    the visible ~50 lines arrives cropped from the top. That is what happened to the
    dut-board topic, whose agent works in dut-stm32-lqfp64/.

    So: trust the tmux session we are running inside (it IS the relay key), and
    failing that walk UP from cwd to the nearest ancestor that already has a reply
    target -- i.e. the folder actually bound to a chat."""
    pane = os.environ.get("TMUX_PANE")
    if pane:
        try:
            s = subprocess.run(["tmux", "display-message", "-p", "-t", pane, "#S"],
                               capture_output=True, text=True, timeout=3).stdout.strip()
            if re.fullmatch(r"cr-[0-9a-f]{10}", s):
                return s
        except Exception:
            pass
    d = os.path.abspath(cwd)
    while True:
        k = _key_for(d)
        if os.path.exists(os.path.join(base, f"target-{k}.json")):
            return k
        parent = os.path.dirname(d)
        if parent == d:
            return _key_for(cwd)
        d = parent

def main():
    try:
        data = json.load(sys.stdin)
    except Exception:
        data = {}
    cwd = data.get("cwd") or os.getcwd()
    base = os.path.join(os.path.dirname(os.path.abspath(__file__)), "relay-work")
    key = resolve_key(cwd, base)
    try:
        os.makedirs(base, exist_ok=True)
        payload = {
            "message": data.get("last_assistant_message", "") or "",
            "transcript": data.get("transcript_path", "") or "",
            "session_id": data.get("session_id", "") or "",
        }
        fd, tmp = tempfile.mkstemp(dir=base)
        with os.fdopen(fd, "w") as f:
            json.dump(payload, f)
        os.replace(tmp, os.path.join(base, f"turndone-{key}.json"))
    except Exception:
        pass

if __name__ == "__main__":
    main()
